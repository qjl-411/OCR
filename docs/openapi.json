      "PatchInvoice": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "invoice_number": {
            "type": "string",
            "maxLength": 32,
            "title": "Invoice Number"
          },
          "invoice_code": {
            "type": "string",
            "maxLength": 20,
            "title": "Invoice Code",
            "default": ""
          },
          "invoice_date": {
            "type": "string",
            "maxLength": 20,
            "title": "Invoice Date"
          },
          "invoice_type": {
            "type": "string",
            "maxLength": 40,
            "title": "Invoice Type"
          },
          "buyer_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Buyer Name"
          },
          "buyer_tax_id": {
            "type": "string",
            "maxLength": 32,
            "title": "Buyer Tax Id",
            "default": ""
          },
          "seller_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Seller Name"
          },
          "seller_tax_id": {
            "type": "string",
            "maxLength": 32,
            "title": "Seller Tax Id",
            "default": ""
          },
          "subtotal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtotal"
          },
          "tax_amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Amount"
          },
          "total": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "tax_rates": {
            "type": "string",
            "maxLength": 80,
            "title": "Tax Rates",
            "default": ""
          },
          "category": {
            "type": "string",
            "enum": [
              "差旅交通",
              "餐饮招待",
              "办公采购",
              "技术服务",
              "其他费用"
            ],
            "title": "Category"
          },
          "remark": {
            "type": "string",
            "maxLength": 2000,
            "title": "Remark",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "invoice_number",
          "invoice_date",
          "invoice_type",
          "buyer_name",
          "seller_name",
          "category"
        ],
        "title": "PatchInvoice"
      },
      "Review": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "needs_review"
            ],
            "title": "Verdict"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "verdict"
        ],
        "title": "Review"
      },
      "Settings": {
        "properties": {
          "workspace_name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Workspace Name"
          },
          "confidence_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.5,
            "title": "Confidence Threshold"
          },
          "amount_tolerance": {
            "type": "string",
            "enum": [
              "0.00",
              "0.01",
              "0.02"
            ],
            "title": "Amount Tolerance",
            "default": "0.02"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workspace_name",
          "confidence_threshold"
        ],
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
