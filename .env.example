# 票序 · 本机账号与邮件服务配置
# 复制为 .env 后由 start.py 加载；此文件仅供本机使用，不要提交到版本库。

# ---- MySQL 账号库 ----
PIAO_MYSQL_HOST=127.0.0.1
PIAO_MYSQL_PORT=3306
PIAO_MYSQL_USER=root
PIAO_MYSQL_PASSWORD=在此填入数据库密码
PIAO_MYSQL_DATABASE=piao_invoice

# ---- 会话令牌密钥（请替换为随机长字符串）----
PIAO_JWT_SECRET=change-me-to-a-random-64-char-secret-string-before-production

# ---- 是否强制业务接口登录校验（1=开启）----
PIAO_AUTH_REQUIRED=0

# ---- SMTP 邮件服务（以 QQ 邮箱为例）----
PIAO_SMTP_HOST=smtp.qq.com
PIAO_SMTP_PORT=465
PIAO_SMTP_SSL=1
PIAO_SMTP_USER=在此填入发件邮箱地址
PIAO_SMTP_PASSWORD=在此填入邮箱授权码
PIAO_SMTP_FROM_NAME=票序 智能发票工作台
